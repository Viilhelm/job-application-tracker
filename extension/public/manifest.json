{
  "manifest_version": 3,
  "name": "JobVault",
  "description": "Save job applications and tailored documents to your Notion workspace.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open JobVault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {"default_path": "popup.html"},
  "permissions": ["activeTab", "storage", "sidePanel", "scripting"],
  "host_permissions": ["https://api.notion.com/*", "https://www.linkedin.com/*"],
  "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["linkedin-adapter.js"], "run_at": "document_idle"}],
  "options_page": "options.html",
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
